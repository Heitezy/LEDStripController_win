<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LEDStripController.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ble="using:LEDStripController.Ble"
    xmlns:local="using:LEDStripController">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="BandTemplate" x:DataType="local:BandOption">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="14" Height="14" Fill="{x:Bind Swatch}" Visibility="{x:Bind SwatchVisibility}" />
                    <TextBlock Text="{x:Bind Name}" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" Margin="20,16,20,24" Spacing="12">

                <TextBlock Text="ELK-BLEDOM &amp; BJ_LED Controller" Style="{StaticResource TitleTextBlockStyle}" />

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />

                <!-- Connection -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Not connected" VerticalAlignment="Center" />
                            <Button x:Name="ScanButton" Grid.Column="2" Content="Scan" Click="Scan_Click" />
                            <Button x:Name="DisconnectButton" Grid.Column="3" Content="Disconnect" IsEnabled="False" Click="Disconnect_Click" />
                        </Grid>
                        <ListView x:Name="DevicesList" MaxHeight="200" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="Devices_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="ble:DiscoveredDevice">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Text="{x:Bind Detail}" Opacity="0.7"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ControlsPanel" Spacing="12">

                    <!-- Power + brightness -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="PowerSwitch" Header="Power" IsOn="True" Toggled="Power_Toggled" />
                            <Slider x:Name="BrightnessSlider" Header="Brightness (%)" Minimum="1" Maximum="100"
                                    Value="100" ValueChanged="Brightness_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Colour -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Colour" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="ColorButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border x:Name="ColorSwatch" Width="28" Height="28" CornerRadius="4" />
                                    <TextBlock x:Name="HexText" Text="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="Picker" Color="White" ColorSpectrumShape="Ring" ColorSpectrumComponents="HueSaturation" IsColorSliderVisible="True"
                                                     IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                                     ColorChanged="Picker_ColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <GridView x:Name="PresetGrid" SelectionMode="None" />
                        </StackPanel>
                    </Border>

                    <!-- Pattern -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <ComboBox x:Name="PatternCombo" Header="Pattern" HorizontalAlignment="Stretch"
                                      SelectionChanged="Pattern_SelectionChanged" />
                            <NumberBox x:Name="DelayBox" Header="Delay (ms)" Minimum="10" Maximum="5000" Value="200"
                                       SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Compact"
                                       Width="180" HorizontalAlignment="Left" Visibility="Collapsed"
                                       ValueChanged="Delay_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Music sync -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="MusicSwitch" Header="Music Sync" Toggled="Music_Toggled" />
                            <ComboBox x:Name="SourceCombo" Header="Audio source" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="Source_SelectionChanged">
                                <ComboBoxItem Content="Microphone" />
                                <ComboBoxItem Content="Phone Audio (system output)" />
                            </ComboBox>
                            <TextBlock Text="Band colours" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <ComboBox x:Name="BassCombo" ItemTemplate="{StaticResource BandTemplate}" Header="Bass" HorizontalAlignment="Stretch" SelectionChanged="Band_SelectionChanged" />
                                    <ProgressBar x:Name="BassBar" Maximum="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <ComboBox x:Name="MidCombo" ItemTemplate="{StaticResource BandTemplate}" Header="Mids" HorizontalAlignment="Stretch" SelectionChanged="Band_SelectionChanged" />
                                    <ProgressBar x:Name="MidBar" Maximum="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <ComboBox x:Name="HighCombo" ItemTemplate="{StaticResource BandTemplate}" Header="Highs" HorizontalAlignment="Stretch" SelectionChanged="Band_SelectionChanged" />
                                    <ProgressBar x:Name="HighBar" Maximum="100" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Bass 60–250 Hz · Mids 250–4000 Hz · Highs 4000–16000 Hz. Phone Audio captures whatever Windows is playing; Microphone listens to the room." />
                        </StackPanel>
                    </Border>

                    <!-- Screen sync -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="ScreenSwitch" Header="Screen Sync (Ambilight)" Toggled="Screen_Toggled" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Mirrors the dominant colour of your primary display to the strip at up to 20 fps." />
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border Style="{StaticResource CardStyle}">
                        <ToggleSwitch x:Name="SmoothSwitch" Header="Ambilight smooth" IsOn="False" Toggled="Smooth_Toggled" />
                    </Border>
                    </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
